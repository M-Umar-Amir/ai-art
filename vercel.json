{
  "version": 2,
  "name": "epical-studio",
  "rewrites": [
    { "source": "/product", "destination": "/product.html" },
    { "source": "/product/buy", "destination": "/buy.html" },
    { "source": "/product/checkout", "destination": "/checkout.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
