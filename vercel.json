{
  "version": 2,
  "name": "epical-studio",
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/product", "dest": "/product.html" },
    { "src": "/product/buy", "dest": "/buy.html" },
    { "src": "/product/checkout", "dest": "/checkout.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
